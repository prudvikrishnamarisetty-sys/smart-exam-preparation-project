# Google Gemini API Key
# Get your free API key from: https://aistudio.google.com/app/apikey
# Then set it here or as an environment variable:  set GEMINI_API_KEY=your_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL Database Connection URL (e.g. from Aiven)
# Example: postgresql://avnadmin:password@host:port/defaultdb?sslmode=require
DATABASE_URL=your_database_url_here
